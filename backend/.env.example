# Copiar como .env dentro de backend y configurar para una base independiente.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Para habilitar datos usar local,db e instalar primero las migraciones.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ventas?sslmode=prefer
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# DB_POOL_SIZE=5
# Para PostgreSQL remoto conservar TLS y el certificado de la entidad emisora.
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/BASE?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt
